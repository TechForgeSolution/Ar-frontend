{
  "expo": {
    "name": "Ange raphael",
    "slug": "ange-raphael",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ange-raphael",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/af3fa615-3f93-4950-aedc-4e0adc647629",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tfs237.ange-raphael",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.angeraphael",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withNonModularHeaders",
      "expo-splash-screen",
      "expo-image-picker",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-video"
    ],

    "extra": {
      "eas": {
        "projectId": "af3fa615-3f93-4950-aedc-4e0adc647629"
      }
    },

    "owner": "ghost777xs-organization"
  }
}